QMainWindow {
    background: {{BG_MAIN}};
}

QToolBar {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 {{BG_TOOLBAR}},
        stop:1 {{BG_MAIN}}
    );
    border-bottom: 2px solid {{BORDER}};
    border-top: 2px solid {{BORDER}};
    spacing: 5px;
    padding: 10px 14px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    min-width: 46px;
    min-height: 46px;
    margin: 2px;
    padding: 3px;
    icon-size: 28px;
}

QToolBar QToolButton:hover {
    background: {{BORDER}};
    border: 1px solid {{BORDER_LIGHT}};
}

QToolBar QToolButton:pressed {
    background: {{BORDER_LIGHT}};
}

QToolBar QToolButton:disabled {
    background: transparent;
    opacity: 0.35;
}

QToolBar QToolButton:checked {
    background: {{PRIMARY}};
    border: 1px solid {{PRIMARY_LIGHT}};
    color: {{ACCENT}};
}

QToolBar QToolButton::menu-indicator {
    width: 0px;
    height: 0px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 5px;
}

QScrollBar::handle:vertical {
    background: {{SCROLLBAR}};
    border-radius: 5px;
    min-height: 50px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: {{SCROLLBAR_HOVER}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 5px;
}

QScrollBar::handle:horizontal {
    background: {{SCROLLBAR}};
    border-radius: 5px;
    min-width: 50px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: {{SCROLLBAR_HOVER}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QMenuBar {
    background: {{BG_TOOLBAR}};
    border-bottom: 2px solid {{BORDER}};
    padding: 5px 8px;
}

QMenuBar::item {
    background: transparent;
    color: {{TEXT}};
    padding: 10px 18px;
    border-radius: 6px;
    font-size: 13px;
    margin: 2px;
}

QMenuBar::item:selected {
    background: {{BORDER}};
    color: {{ACCENT}};
}

QMenuBar::item:pressed {
    background: {{BORDER_LIGHT}};
    color: {{ACCENT}};
}

QMenu {
    background: {{BG_TOOLBAR}};
    border: 1px solid {{BORDER}};
    border-radius: 10px;
    padding: 8px;
}

QMenu::item {
    color: {{TEXT}};
    padding: 10px 36px 10px 18px;
    border-radius: 6px;
    font-size: 13px;
}

QMenu::item:selected {
    background: {{BORDER}};
    color: {{ACCENT}};
}

QMenu::separator {
    height: 1px;
    background: {{BORDER}};
    margin: 6px 12px;
}

QDialog {
    background: {{BG_MAIN}};
}

QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 {{PRIMARY}},
        stop:1 {{PRIMARY_DARK}}
    );
    color: {{BTN_TEXT}};
    border: 1px solid {{PRIMARY_LIGHT}};
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 {{PRIMARY_LIGHT}},
        stop:1 {{PRIMARY}}
    );
}

QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 {{PRIMARY_DARK}},
        stop:1 {{PRIMARY_DARKER}}
    );
}

QPushButton:disabled {
    background: {{BORDER_LIGHT}};
    color: {{DISABLED}};
    border-color: {{BORDER}};
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background: {{BG_TOOLBAR}};
    color: {{TEXT_LIGHT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid {{PRIMARY_LIGHT}};
}

QLabel {
    color: {{TEXT}};
    font-size: 14px;
}

QListWidget {
    background: {{BG_TOOLBAR}};
    border: 1px solid {{BORDER}};
    border-radius: 10px;
    padding: 6px;
    color: {{TEXT_LIGHT}};
}

QListWidget::item {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 3px;
}

QListWidget::item:selected {
    background: {{PRIMARY}};
    color: {{BTN_TEXT}};
}

QListWidget::item:hover {
    background: {{BORDER}};
}

QComboBox {
    background: {{BG_TOOLBAR}};
    color: {{TEXT_LIGHT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
}

QComboBox:hover {
    border-color: {{PRIMARY_LIGHT}};
}

QComboBox::drop-down {
    border: none;
    width: 36px;
}

QComboBox::down-arrow {
    width: 14px;
    height: 14px;
}

QCheckBox {
    color: {{TEXT}};
    spacing: 12px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border: 2px solid {{BORDER_LIGHT}};
    background: {{BG_TOOLBAR}};
}

QCheckBox::indicator:hover {
    border-color: {{PRIMARY_LIGHT}};
}

QCheckBox::indicator:checked {
    background: {{PRIMARY}};
    border-color: {{PRIMARY_LIGHT}};
}

QRadioButton {
    color: {{TEXT}};
    spacing: 12px;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border: 2px solid {{BORDER_LIGHT}};
    background: {{BG_TOOLBAR}};
}

QRadioButton::indicator:hover {
    border-color: {{PRIMARY_LIGHT}};
}

QRadioButton::indicator:checked {
    background: {{PRIMARY}};
    border-color: {{PRIMARY_LIGHT}};
}

QMessageBox {
    background: {{BG_MAIN}};
}

QMessageBox QLabel {
    font-size: 14px;
    color: {{TEXT}};
}

QTableWidget {
    background: {{BG_TOOLBAR}};
    border: 1px solid {{BORDER}};
    border-radius: 10px;
    gridline-color: {{BORDER}};
    color: {{TEXT}};
}

QTableWidget::item {
    padding: 10px;
    border-radius: 4px;
}

QTableWidget::item:selected {
    background: {{PRIMARY}};
    color: {{BTN_TEXT}};
}

QHeaderView::section {
    background: {{BORDER}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    padding: 10px;
    font-weight: 600;
}

QToolTip {
    background: {{BG_TOOLBAR}};
    color: {{TEXT_LIGHT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QStatusBar {
    background: {{BG_TOOLBAR}};
    border-top: 1px solid {{BORDER}};
    color: {{DISABLED}};
    padding: 6px 12px;
}

QGroupBox {
    background: {{BG_TOOLBAR}};
    border: 1px solid {{BORDER}};
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: 600;
    color: {{TEXT}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 4px 12px;
    background: {{BG_MAIN}};
    color: {{ACCENT}};
}
